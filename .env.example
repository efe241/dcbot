# Application & Security
SECRET_KEY=change_this_to_a_secure_random_string_min_32_chars
ENVIRONMENT=development
PORT=8000
BASE_URL=http://localhost:8000

# Database Settings (PostgreSQL for production, SQLite async default for quick testing)
# Example Postgres: postgresql+asyncpg://user:password@localhost:5432/cpx_coins
DATABASE_URL=sqlite+aiosqlite:///./cpx_coins.db

# CPX Research Settings
